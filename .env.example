# =====================================================================
# GraphSQL Studio — Local & Production Configuration
# Copy to .env and fill in up to 3 API keys (automatic failover from
# Key 1 -> Key 2 -> Key 3 on errors or token limits), LLM_BASE_URL,
# LLM_MODEL, and optional LLM_TIMEOUT_SEC.
# =====================================================================

LLM_API_KEY=""
LLM_API_KEY_2=""
LLM_API_KEY_3=""
LLM_BASE_URL=""
LLM_MODEL=""
LLM_TIMEOUT_SEC=""

# Interconnected Service & Dataset Settings (Pre-Configured)
PORT="3000"
PYTHON_BACKEND_PORT="8765"
APP_URL="http://localhost:3000"
SPIDER_DATA_DIR="data/spider"
